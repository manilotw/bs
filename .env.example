# Шаблон настроек. Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env не коммитится (он в .gitignore). Переменные окружения системы важнее значений из .env.

# ---------------------------------------------------------------- Django
# Секретный ключ — обязателен. Сгенерировать:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# 1 — режим разработки, 0 — боевой сервер
DJANGO_DEBUG=1
# Домены сайта через запятую (на сервере: buh-service.kz,www.buh-service.kz)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Для HTTPS на сервере: https://buh-service.kz,https://www.buh-service.kz
DJANGO_CSRF_TRUSTED_ORIGINS=
# Порт `python manage.py runserver` по умолчанию (8000 не занимаем)
RUNSERVER_PORT=8001
TIME_ZONE=Asia/Almaty
# Папка для collectstatic (относительно корня проекта)
STATIC_ROOT=staticfiles

# ------------------------------------------------------------ База данных
# SQLite по умолчанию. Для PostgreSQL: DB_ENGINE=django.db.backends.postgresql и заполнить остальное
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=60

# ------------------------------------------------ Безопасность (сервер с HTTPS)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
# Например 31536000 (год), когда HTTPS настроен окончательно
SECURE_HSTS_SECONDS=0
# 1 — если сайт стоит за nginx/прокси, который передаёт X-Forwarded-Proto
USE_X_FORWARDED_PROTO=0

# ------------------------------------------------------------ Почта и заявки
# Куда дублировать заявки письмом (через запятую). Пусто — заявки только в БД/админке.
LEAD_NOTIFY_EMAILS=
# console — письма печатаются в консоль; для реальной отправки: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=

# ------------------------------------------------------ SEO, аналитика, карты
# Адрес сайта для canonical, og-тегов, robots.txt и sitemap.xml
SITE_URL=https://buh-service.kz
# Счётчики (те же, что были на Tilda)
YANDEX_METRIKA_ID=72061132
FACEBOOK_PIXEL_ID=1121663565484331
# Пусто — счётчики включены только при DJANGO_DEBUG=0. 1/0 — включить/выключить принудительно
ANALYTICS_ENABLED=
# Ключ JS API Яндекс.Карт (developer.tech.yandex.ru); для разработки можно оставить пустым
YANDEX_MAPS_API_KEY=
